{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(./node_modules/.bin/oxlint:*)",
      "Bash(openspec:*)",
      "Bash(npx vitest run:*)",
      "Bash(node scripts/record-fixture.ts:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated.sh\"",
            "timeout": 10,
            "statusMessage": "Checking generated files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.sh\"",
            "timeout": 30,
            "statusMessage": "oxlint on the changed file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.sh\"",
            "timeout": 120,
            "statusMessage": "Verifying: lint + tests"
          }
        ]
      }
    ]
  }
}
