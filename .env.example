# Copy to .env and adjust. Every value has a default — the schema lives in
# src/config/env.schema.ts and the app refuses to start when the env does not match it.

NODE_ENV=development
PORT=3000

# Default source for every capability and for place lookup:
#   mock       recorded fixtures, no network at all — the development default,
#              and the only source this build implements
#   open-meteo the live API
#   record     the live API with a fixture writer attached: every response it
#              serves is also written to the fixture set. A decorator over
#              open-meteo, never the default, and it refuses to replace an
#              existing recording unless WEATHER_RECORD_REPLACE=true
# A source named here but not implemented refuses the start; the service never
# substitutes another one.
WEATHER_PROVIDER=mock

# Per-capability overrides. Forecast, marine and archive are separate seams, so
# each can be pointed at a different vendor without a code change. Unset means
# WEATHER_PROVIDER. Place lookup is not a capability and follows WEATHER_PROVIDER
# alone.
# WEATHER_FORECAST_SOURCE=mock
# WEATHER_MARINE_SOURCE=mock
# WEATHER_ARCHIVE_SOURCE=mock

# Whether WEATHER_PROVIDER=record may write over a fixture that already exists.
# Recording is one explicit choice; replacing a recording is a second one.
WEATHER_RECORD_REPLACE=false

# Default forecast horizon (1..16). Past 7 days the ranking is mostly noise.
FORECAST_DAYS_DEFAULT=7

# The longest horizon a ranking request may ask for. Anything longer is refused
# here, before any outbound call, rather than shortened.
FORECAST_DAYS_MAX=7

# --- Cache ------------------------------------------------------------------
# Which adapter is bound. Unset means "memory", except under NODE_ENV=test,
# where it means "null": a fixture that stopped being read must not hide behind
# a hit left by an earlier test.
# CACHE_ADAPTER=memory

# The store is bounded by both, and needs both: a count alone lets a few large
# series exhaust the heap, a size alone lets a flood of tiny negative entries
# evict everything useful.
CACHE_MAX_ENTRIES=5000
CACHE_MAX_BYTES=33554432

# Per-capability lifetimes, in seconds. Freshness ends on the boundary of the
# interval rather than an interval after whoever asked first, so these describe
# the source's own refresh cadence: hourly for the forecast and the wave model,
# daily for the archive.
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_MARINE_CACHE_TTL_SECONDS=3600
WEATHER_ARCHIVE_CACHE_TTL_SECONDS=86400

# How old data may be and still be served, marked stale, when it cannot be
# refreshed. Past it there is no answer to give and the request is a miss. It
# can never be shorter than the lifetime above; the schema refuses that.
WEATHER_CACHE_MAX_STALE_SECONDS=10800
WEATHER_MARINE_CACHE_MAX_STALE_SECONDS=10800
WEATHER_ARCHIVE_CACHE_MAX_STALE_SECONDS=604800

# How long a resolved place name is reused, and how long a name that resolved
# to nothing is remembered as nothing. The second is short on purpose: long
# enough to blunt an enumeration of invented names, short enough not to hold a
# corrected typo.
GEOCODING_CACHE_TTL_SECONDS=2592000
GEOCODING_NEGATIVE_TTL_SECONDS=300

# --- Outbound budget and resilience -----------------------------------------
# One limit per window of Open-Meteo's published table. The unit is an
# attempt, retries included: a retry spends quota exactly like a first call,
# and retries multiply when the source degrades. The daily window binds — it is
# twelve times stricter than the hourly one.
OUTBOUND_BUDGET_PER_MINUTE=600
OUTBOUND_BUDGET_PER_HOUR=5000
OUTBOUND_BUDGET_PER_DAY=10000

# How many calls may be out at once, and how many may wait for a slot. Beyond
# both, a request is refused rather than queued.
OUTBOUND_CONCURRENCY=8
OUTBOUND_CONCURRENCY_QUEUE=8

# Per attempt, never per chain. Live p95 is 136 ms.
OUTBOUND_TIMEOUT_MS=2000

# Attempts including the first, and the growth of the jittered delay between
# them. A delay the source states in Retry-After wins over both.
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_INITIAL_DELAY_MS=150
OUTBOUND_RETRY_MAX_DELAY_MS=5000

# Consecutive source faults that cut one source-and-capability pair off, and
# how long before it is tried again. Per pair, not per source: a failing wave
# model must not stop the forecast served by the same vendor.
BREAKER_CONSECUTIVE_FAILURES=5
BREAKER_HALF_OPEN_AFTER_MS=30000

# Arrives in stage 8. REDIS_URL is read by nothing yet: the cache port is
# ready and the adapter is one file, and it is written when a second instance
# makes the arithmetic change.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rank_activities
# REDIS_URL=redis://localhost:6379

# --- Rules -------------------------------------------------------------------
# Where the rules are read from. `files` is the default and the source of truth:
# the service starts, validates and ranks with no database at all. `store` reads
# the versions published into PostgreSQL instead, which is what a deployment
# chooses when a newly published version should be picked up without a restart.
# It requires DATABASE_URL, and the schema refuses the start without one.
ACTIVITY_CATALOGUE_SOURCE=files

# How long the in-process copy of the rules is trusted before the store is asked
# whether a newer version exists. Read only when the source is `store`. Rules
# change about once a month, so this is a cadence, not a consistency mechanism.
ACTIVITY_CATALOGUE_REFRESH_SECONDS=300

# --- Audit -------------------------------------------------------------------
# How long a computation record may wait in memory before a flush is attempted,
# and how many may wait at once. The audit is written off the hot path and may be
# lost: an answer never waits for it, and what is lost is exposed as a metric.
# Past the record count the oldest are dropped, because a buffer without a bound
# turns a store outage into an out-of-memory kill.
AUDIT_FLUSH_INTERVAL_SECONDS=5
AUDIT_BUFFER_MAX_RECORDS=1000
