# Copy to .env and adjust. Every value has a default — the schema lives in
# src/config/env.schema.ts and the app refuses to start when the env does not match it.

NODE_ENV=development
PORT=3000

# Default weather source for every capability: mock — fixtures, no network
# (the development default), open-meteo — the live API, record — the live API
# plus fixture recording. A source named here but not implemented refuses the
# start; the service never substitutes another one.
WEATHER_PROVIDER=mock

# Per-capability overrides. Forecast, marine and archive are separate seams, so
# each can be pointed at a different vendor without a code change. Unset means
# WEATHER_PROVIDER.
# WEATHER_FORECAST_SOURCE=mock
# WEATHER_MARINE_SOURCE=mock
# WEATHER_ARCHIVE_SOURCE=mock

# Default forecast horizon (1..16). Past 7 days the ranking is mostly noise.
FORECAST_DAYS_DEFAULT=7

# Forecast cache TTL in seconds, aligned with the Open-Meteo refresh rate (~1 hour).
WEATHER_CACHE_TTL_SECONDS=3600

# Arrive in stages 6 and 8.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rank_activities
# REDIS_URL=redis://localhost:6379
