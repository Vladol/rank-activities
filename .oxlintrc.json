{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "import/no-cycle": "error",
    "no-underscore-dangle": ["warn", { "allow": ["__typename"] }]
  },
  "overrides": [
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nestjs/*", "**/modules/**", "**/infrastructure/**", "**/adapters/**"],
                "message": "src/domain is the pure core: no Nest, no I/O, no infrastructure (docs/development-flow/flow.md, section 4.3). Dependency arrows point inward only."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
